<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <service android:name="com.storytellerf.llmd.LlmdModelService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-controlled offline AI model inference for authorized local apps" />
        </service>
        <!-- Allow LiteRT-LM to load vendor GPU drivers on Android 9+. -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.storytellerf.llmd.LlmdIpcService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.storytellerf.llmd.action.BIND_IPC" />
            </intent-filter>
        </service>

        <activity
            android:name="com.storytellerf.llmd.LlmdIpcAuthorizationActivity"
            android:exported="true"
            android:label="@string/ipc_authorization_title">
            <intent-filter>
                <action android:name="com.storytellerf.llmd.action.AUTHORIZE_CALLER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
